<?xml version="1.0" encoding="utf-8"?>
<!--
  NuGet configuration used only by the Azure Pipelines release builds
  (publish.yml and publish-docker.yml).

  Routes all package restores through the DevDiv_PublicPackages Azure Artifacts
  feed instead of nuget.org, as required by SFI-ES4.2.4. The pipelines copy it to
  the repository root before any dotnet command so every restore discovers it, and
  NuGetAuthenticate@1 provides the credentials for the feed.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="DevDiv_PublicPackages" value="https://pkgs.dev.azure.com/devdiv/DevDiv/_packaging/DevDiv_PublicPackages/nuget/v3/index.json" />
  </packageSources>
</configuration>
